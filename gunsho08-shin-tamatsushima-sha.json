 "poems": [
  {
   "seq": "1",
   "text": "和歌のうらや風おさまれる御代なれはいくへ霞も立渡るらむ",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "もしほ燒なにはのみつの朝かすみ煙をこめてたちやそふらん",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "ゆふ日かけかたふく浦のなみまより霞もはてぬ松のむらたち",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "みくまのや浦こく舟のほのかにもみえすかすめる波の遠かた",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "たちこむるすゑは雲ちのうら〓〓にかすみて遠きおきの釣舟",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "わかのうらや雲と浪との末とほくかすみもやへの春の明ほの",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "あけわたす浦のはつ島はつかにもみえぬや深き霞成らむ",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "みとりなる霞の色にかけてけりまたはつ草のわかのうら浪",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "紀のうみや浪もかすみも立まよひそら吹上の春のうらかせ",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "霞のみたつとはみえて難波かた浪しつかなるはるの明ほの",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
