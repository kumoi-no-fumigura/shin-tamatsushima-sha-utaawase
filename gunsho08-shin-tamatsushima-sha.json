  {
   "seq": "14",
   "text": "あさなきの浦路のとけき八重霞波はこゑさへ立へたてつる",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "明石かたせとのしほ風吹にけり霞もはてぬ奥津しら浪",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "和歌の浦やみちくる鹽はみえわかて霞のまより波はいさよふ",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "いくうらのちさとの波もうつもれて霞そやへの鹽ち也ける",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "わかのうらや松こそ春の色ならめ浪さへかすむみとりそふ覽",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "わかの浦や鹽のみちひもみえぬまてあしへはるかに霞む頃哉",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "和歌の浦やあしへのたつのこゑはかり浪にきこえて立霞哉",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "ふみ迷ふわかの浦なみ代ゝかけしあとゝもみえすなと霞む覽",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "あさみとり立そう春の色みえて松よりかすむ和歌の浦なみ",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "白妙のはまのまさこを吹上や霞をよするはるのうら風",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "すみよしのうらふく風もあさみとり松にはあへす霞春かな",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "春といへは猶しほかせのふきあけに霞もはてぬわかのうら松",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "なみかゝるよとのつきはしたえ〓〓に霞もはてぬまのゝ浦風",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "ゆふなきのはるの浦なみはる〓〓とかすみをわくる蜑の釣舟",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "よさの浦やなきたる朝に見渡せはたえ〓〓霞むあまのはし立",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "浪とをくゆきかふ舟もほの〓〓とみとりに霞むわかの浦まつ",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "和歌の浦やつのくむころのあしへより霞そ渡る花のみとりに",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "汐かせものとけき浦のゆふなきにかすみより立奥津しらなみ",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "わたつ海やしほのひるまのはまひさき霞のみをや又埋むらん",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "もしほ燒けふりもおなしかすみにて雲井につゝく浦の松原",
   "kana": "",
   "speaker": "",
   "page": 359,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "きよみかた霞吹しくうら風にこつゑそはるゝみほの松原",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "紀のうみやいく浦かけてかすむらんゆらの湊の春のあけほの",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "はしたてや霞わたれる曙にをとのみよするよさのうら浪",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "はる〓〓と霞へたてゝ今は身のよるかたしらぬわかのうら浪",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "春くれはけふりも波もうつもれて霞のみ立しほかまの浦",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "かすみてそなをかきりなきわたの原やへの鹽ちの奥津しら浪",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "なみのうへにゆきかふ舟もきえはてゝ霞にのこる淡路島由",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "もしをやく浦のけふりの末ならてたちそふころの朝霞かな",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "和歌の浦や浪ちの末もはる〓〓ととをさにつけて猶霞むらし",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "朝かすみたつとはみねとわたのはら猶うら風のさゆる春哉",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "須磨のうらやなみの干里は立こめて霞にのこる淡ち島山",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "春の色のいまひとしほやこれならむみとりに霞わかの浦まつ",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "吹かせものとけき春の朝なきに霞をよする和歌のうら浪",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "はる〓〓と明行よさのうらなみに霞そ渡るあまのはし立",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "わかのうらやみきはの松の春の色に浪のいつくもかすむ頃哉",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "今朝はなを霞にけりな鹽竈のうらの煙もわかぬはかりに",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "みとりそふ松のみ春はあらはれて木のまにかすむわかの浦浪",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "和歌の浦やよせくる浪はのとかにてかすみ計そ立とみえける",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "よそにたにこきゆく舟はみえわかてそらよりをちにたつ霞哉",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "紀のうみやそこともしらすたちこめて霞たゆたふわかの浦風",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "霞のみたつとそみゆるわかの浦の浪と風とのおさまれるよは",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "あらほらけほとはへたてすきこゆ也霞にのこる和歌のうら浪",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "うら風の吹上のはまもなのみして霞にこもる春のあけほの",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "ひのいづるおきつそらより明そめてそらの霞によや殘るらん",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "わかの浦の浪はへたてしをともなしいかにたちそふ霞成らん",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "うら〓〓のなきたる朝もふく風に霞のこせる松のむらたち",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "きのうらや音はかりして浦風のよはれはかすむをきつしら浪",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "浦なみのみきはに遠くなり行や立そふ春のかすみなるらむ",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "とをさかる浦半のまつの色なからみとりをそへて立霞かな",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "わたのはらのこる日かけもくれなゐの霞にかゝる奥つ白浪",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "久かたの空こそ春にかすむとてたちなへたてそわかのうら浪",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "はる〓〓とおきつ浪間はうつもれて霞にうかふわかの浦松",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "花とみる雲のよそめにあくかれてきにし心のはるの山みち",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "みよしのはしのふの山にあらねとも花に分入おくのかよひち",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "山深みかきりもしらす分けいらん花よりおくに花もありやと",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "このもとにけふはくらしつ明はまたあらぬ山ちの春や立らむ",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "あくかるゝ心を花のしるへにてやまちの雲をいくへこゆらん",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "山さくらあかぬこゝろをしるへにていくへもわけむ岑の白雲",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "かへるさは道まよふとも山櫻かつさくみれを猶やたつねむ",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "わけわけぬこゝろ計はさきたてとしらぬ野山を花にまかせて",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "たつねきて千代もへぬへき影なれや櫻にうつむあとの白雲",
   "kana": "",
   "speaker": "",
   "page": 360,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "山ふかくわけつる花のかけなれやさくらにうつむ跡のしら雲",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "いくたひか花にまかへて白雲のかゝるやまちに尋ねきぬらん",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "さくらかりはなかとみゆる白くものいくへの峯に人さそふ覽",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "見ぬかたも花をたよりにきつる哉歸る山路のあとたとるまて",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "櫻狩くれなはけふそかへらましまれなる花のかげはたのまて",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "行まゝに由はさくらにあらはれて花よりつゝく峯の白雲",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "いたつらにゆきては歸る日數へてまたみぬ花に猶やまよはぬ",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "まかひつるよそめを道のしるへにて花にわけなす峯のしら雲",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "けふいくかよそめははなと峯の雲わけてもこりぬ心なるらん",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "木の本にけふはくらさむ櫻花かへさをおくれ山のはの月",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "たつねこしあとはいくへの霞ともしらぬ山路の花にくらしつ",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "分すきて行衞の道に咲はなをかつみよし野の奥そゆかしき",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "ゆくすゑは花をかきりの山ちともみえぬおのへの山のしら雲",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "みやこふといつれを花のさかひともしらぬ山路の雲やわく覽",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "わけいれははなにもうつむあとなくて猶立まよふ峯のしら雲",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "みよし野はいつくも花の影なれはわきてしほりの跡も尋ねす",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "咲にけりたつねぬさきの日影さへけふはくやしき山さくら哉",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "わけきつる心つくしはやま櫻うき身なからも哀とをみよ",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "分まよふ花の所のしるへして雲より匂ふ春のやまかせ",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "たつね入道も梢のさかりにてはなゆへ花のかけやくれなむ",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "まかひける雲に山路をさそわれてけに咲花のところをそしる",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "雲とのみよそにみえつる山櫻わけ入まゝに花になりゆく",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "しをりせし道はたのまて山さくら花のかにのみまかせてそ行",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "よそにして尋ねもゆかし身の憂きを花に任せて見る世ならすは",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "花ゆへにいまさらとはゝ我宿とたのむよしのも道やたと覽",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "けふははやたつねくらして山櫻あすのためなる春のしたふし",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "しら雲のしらぬ山道は花の香の風をたよりにたつれてそ行",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "たつねゆく末に心のいそかれて花ゆへ花をしつかにも見す",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "白くものかさなる峯はとをくともこえてや花をみよし野の山",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "咲花のこのもとちかくなりぬらしにほひそふかき春の山風",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "ふきさそふかせのさきにとあくかれて花よりあたにちる心哉",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "山ふかく分入はなのおもかけを霞をそむるみねのしら雲",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "あくかるゝ心を花のしるへにてまたみぬ山のおくもまよはず",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "山深みわけこしほともしられぬは花にやうつるこゝろ成らん",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "きのふまて分こしやまをよのまにも花咲ぬやと又たつねつゝ",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "けふも猶うはのそらにやまよはまし花みて歸る人しあかすは",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "木のもとにこよひかさねん行末の雲をはあすの花にのこして",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "しるへなき山のかすみにわけ入てまた見ぬ花に道たとるなり",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "分ゆかは花のところとなりやせん山ちのすゑにかゝる白雲",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "あへかるゝ花のこころをしるへにて山路たとらぬ花さかり哉",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "咲そむるこすゑやあると花ゆへにけふもやまちを尋ねつる哉",
   "kana": "",
   "speaker": "",
   "page": 361,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "山ふかみまたみぬ方をたつねきて心をはなに迷ひつる哉",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "にほひくる風をたよりに白雲のかゝれるかたに花やたつねん",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "日數へてはなにそこゆる雲井路の春けき程とみえしたかねを",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "わけこすは花ともしらていたつらにさてやはつせの峯の白雲",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "いつくともしらぬやまちの花の香にやへ立雲を分やつくさん",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "みよし野や雲のおくまてしるへせよ花のか深き春の山かせ",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "けふも猶はなにはなくていたつらに雲のみわくる春のやま道",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "花かとて木のもと〓とに立よれはたゝ雨雲のよそめ成けり",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "山櫻またみぬかたのしるへには風そまたるゝあふ人はなし",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "よそめにはたれかはわかむたつねくる山ちも春に迷ふ白雲",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "あすもなをたつねやせまし吉野山けふみぬ方に春や殘ると",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "そことなき春の山路をたとるかな人たのめなる風の匂ひに",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "あかす猶わけてやみまし山ふかみ花よりおくのみねの白雲",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "分つくす花にこよひも旅ねしてあすはいつくの山ちくらさむ",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "花かともとひてそみまし山の端の雲ににほひはあらしふく也",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "麓まてけさにほひつる花のかや夕こえかゝろ山のしたかせ",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "たのむかな我ふちはらの都よりあとたれそめし玉つ島姫",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "みつかきのみかゝれしよりやはらくる光そまさる玉津しま姬",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "言のはの露もみたれぬあしはらやひかりをそふる玉つ島姫",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "たまつしまもとの光にまさるらし都にうつす神のみやゐは",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "幾千代もまもりはすてし敷島のやまとしま根の神のくにとて",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "ことの葉をいかてみかゝむ玉津しまめくみしらるゝ神の光は",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "あまてらすかけをみかきてたまつ島神よのあとは猶守るらし",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "今もかもみかきやそへむたまつ島神のしるしの跡もかはらす",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "いとゝ猶ひかりをみかく玉津島みちをも世をもさそ照すらし",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "さゝかにの雲の糸すちよりかけてたえぬとはの玉つ島ひめ",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "やはらくるひかりも道をてらすらむ今はたみかく玉津島姫",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "こゝのへに宮ゐをいまもうつしきて昔にかへる玉つしまひめ",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "おろかなる心は神そてらすらん我ふみまよふしきしまの道",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "みかきなす玉つしまひめ君か代の光そへとや跡をたれけん",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "神もさそひかりをそへむ玉津島あらたにみかく時をまちえて",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "えにしありてうつる光も玉つしまたゝ我道のしるへ也けり",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "波の下にしつみはてしをもしほ草神そ手向のかすもいれつる",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "いく千代も猶まもるらし玉つしま曇らぬ君かおなしひかりを",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "都にも光をわけてたまつしまくもりなきよをさそ守るらむ",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "君かよにふたゝひみかく言のはの光もそひぬ玉つしまひめ",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "あとたれし昔をとへは玉つ島かみ世の松にうらかせそふく",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "いにしへもかくやはみかく玉つしま光をそへよ今のみやゐに",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "和歌のうらや浪のしらゆふ代々かけて我道まもる玉つ島姫",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "ゆふしてのなひかむ末もあつさ弓遙に照せ玉つしま姫",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "いさなとる海のはまもにあらはれて心をよせしたまつしま姬",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "あとたるゝ名もあらはれて和歌の浦やもに埋もれぬ玉つ島姫",
   "kana": "",
   "speaker": "",
   "page": 362,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "神かきもあらたにみかく玉つ島あきらけき世の程はみえけり",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "千早ふる神しうけすは玉津島たまならぬ身の名をかけめやは",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "萬代もさそやまもらむ玉津島みかきそへぬる神のひかりに",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "うつもるゝ宮ゐはこゝにあらはれて光もそひぬ玉つ島ひめ",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "たまつしま花の都にあとたれて君をやちかく猶まもるらし",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "玉津島たえぬ浪ちにうかふ淡のうたかた守る神もたのまし",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "宮ゐして君をそまもる玉つ島光をそふる萬代よ〔行敷〕まてに",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "めにみえぬ神のあはれむ道を猶わきてそまもる玉つしま姬",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "さそなけに神もうくらむ和歌の浦にあつむる玉の光あるよを",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "世ゝへぬるあとはあれとも玉つ島けふの手向やわきてうく覽",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "さらにまたひかりそふらし玉つ島みかきかさぬる神の宮ゐに",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "和歌のうらにあとたれしより世々をへて光そまさる玉つ島姫",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "今そ猶ひかりはまさるたまつしまこゝも昔の宮居なれとも",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "よる浪のつての藻くすももらすなよみかく〓とはの玉つしま姫",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "和歌のうらの道あるみ代の光にそ跡をもたる〓玉つ島ひめ",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "いにしへにかはらぬあとやしらるらむうつす光の玉つしま姬",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "たまつ島きみかみかける神垣にやちよの末をさそ照すらむ",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "たまつ島みかける君を萬代と神のこゝろにさそ守るらん",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "九重にちかきまもりと玉津島光をわけて神やすむらん",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "やはらくろ光をそへて玉つしまかみの宮ゐもみかくとそ見る",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "あらたなる神のゐかきの松かえに君か千年はかねてしるしも",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "こゝにまたみやゐせしよりやはらくる光やうつす玉つ島姫",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "いとゝしくみかくひかりに敷島の道をやてらす玉つ島ひめ",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "玉つしま宮ゐをこゝにうつしてや猶この道のひかりそふらむ",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "182",
   "text": "玉つしまたむくろからに言のはの露にもみかく色や見ゆらむ",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "183",
   "text": "こゝに又あとをたれよとやはらくる光をうつす玉つ島ひめ",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "184",
   "text": "干はやふる神よの道をそのまゝにのこして守るたまつ島姫",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "185",
   "text": "君か代にみかく道とや玉つ島いまのみやゐもひかりそふらん",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "186",
   "text": "よろつよの君かひかりと宮はしらたてゝそみかく玉つ島ひめ",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "187",
   "text": "今さらにみかきそへよとひかりをはみやこにわくる玉つ島姫",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "188",
   "text": "おろかなる我とのはもたまつ島みかくひかりをたのむ計に",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "189",
   "text": "この道の〓とはをみかく玉津島ちかひやよゝにたゝせさるらむ",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "190",
   "text": "おなしくはみかく心のかひも哉露の〓葉葉の玉つしま姬",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "191",
   "text": "和歌のうらにひろへとつきぬ玉つ島よゝの光は神のまに〓〓",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "192",
   "text": "いとゝ猶光やそへんたまつしま世のあきらけき時にあひつゝ",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "193",
   "text": "跡たれてこゝにそ今はきの國やそのなふりにし玉津島姫",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "194",
   "text": "玉つしまみやこのちりにましはるや猶道まもるちかひ成らむ",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "195",
   "text": "おさまれるよにみかゝれて玉つ島なをあらたなる光そふらん",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "196",
   "text": "みかきえぬこと葉の露のたまつ島神も光をそへさらめやは",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "197",
   "text": "まもりける道もあらたに玉津島みかきあつむるやまと言の葉",
   "kana": "",
   "speaker": "",
   "page": 363,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
